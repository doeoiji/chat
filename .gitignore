# Dependencies
node_modules/

# Environment variables
.env
.env.local

# Firebase credentials (never commit secrets)
firebase-service-account.json
*-firebase-adminsdk-*.json
android/app/google-services.json

# Runtime user & chat data (keep folder structure via .gitkeep)
data/*
!data/users/
!data/chats/
data/users/*
!data/users/.gitkeep
data/chats/*
!data/chats/.gitkeep
data/pending/
data/outbox/

# Logs and temporary files
*.log
*.tmp
.DS_Store
Thumbs.db

# Android Studio / Gradle build artifacts
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
