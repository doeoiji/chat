# Server Configuration
PORT=3000
HOST=127.0.0.1

# Maximum file upload size in megabytes
MAX_UPLOAD_MB=25

# Optional custom secret for signing session cookies (auto-generated in data/.secret if omitted)
# SESSION_SECRET=change-this-to-a-long-random-string

# Optional SMTP configuration for sending real email verification codes
# Example for Gmail: use smtp.gmail.com, port 587 (or 465 with SMTP_SECURE=true), and a Google App Password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=VibeRoom <your-email@gmail.com>

# When SMTP is not configured, verification codes are logged locally to data/outbox/
# Set to false in production to never return a dev preview code to the client
# ALLOW_DEV_EMAIL_CODE=true

# Optional Web Push (VAPID keys are auto-generated in data/.vapid.json if omitted)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@viberoom.app

# Optional Firebase Cloud Messaging (for Android APK background push notifications)
# Provide a path/JSON for a Firebase service account, OR set project/client/key individually:
# FCM_SERVICE_ACCOUNT_JSON=./firebase-service-account.json
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

PORT=3000
HOST=127.0.0.1

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mdjulkarnain10@gmail.com
SMTP_PASS=fmforsmmerdtefui
SMTP_FROM=VibeRoom <mdjulkarnain10@gmail.com>

ALLOW_DEV_EMAIL_CODE=false